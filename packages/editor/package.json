{
  "name": "@formkl/editor",
  "type": "module",
  "version": "0.3.0",
  "description": "A universal Editor for Formkl using web component API",
  "author": "thecodeorigin",
  "license": "MIT",
  "homepage": "https://github.com/imrim12/formkl#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/imrim12/formkl.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/imrim12/formkl/issues"
  },
  "keywords": [
    "formkl",
    "editor"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npx unbuild"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@formkl/shared": "workspace:*",
    "codemirror": "catalog:",
    "formkl": "workspace:*"
  }
}
